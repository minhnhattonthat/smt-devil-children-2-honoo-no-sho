  "slots": [
   "252310"
  ],
  "idx": [
   3498
  ],
  "jp": "戦いが　きらいな[n]心やさしいデビル[n]自分の　チエで[n]平和で　安全な[n]世界をつくろうと[n]している[end]",
  "en": ""
 },
 {
